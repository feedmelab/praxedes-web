# ── Base de datos (Neon) ──────────────────────────────────────
# Usar la connection string "pooled" para la app
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/praxedes?sslmode=require"
# Usar la connection string "direct" para migraciones de Prisma
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/praxedes?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-secret-real"
AUTH_URL="https://admin.praxedesdevilallonga.com"

# ── ImageKit ──────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/tu-id"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/tu-id"

# ── Vimeo (extractor de fotogramas) ──────────────────────────
# Access token de la cuenta Vimeo Pro con scopes: private, video_files, edit,
# upload (upload hace falta para crear fotogramas vía Pictures API).
# Generar en developer.vimeo.com → My Apps → Authentication.
# Debe pertenecer al propietario de los vídeos privados.
VIMEO_ACCESS_TOKEN=""

# ── Resend (formulario de contacto) ──────────────────────────
# API key de Resend (resend.com → API Keys). Solo en el servidor.
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio verificado). Formato:
#   "Web Práxedes <web@praxedesdevilallonga.com>"
# Si se deja vacío se usa el remitente de pruebas onboarding@resend.dev.
CONTACT_FROM=""
# Destinatario de respaldo si SiteSettings.contactEmail está vacío.
CONTACT_TO="hola@praxedesdevilallonga.com"

# ── Cloudflare Turnstile (captcha del formulario de contacto) ──
# Crea un widget en dash.cloudflare.com → Turnstile (gratis). Elige modo
# "Managed" (invisible/no molesto). Copia las dos claves aquí.
# Si se dejan vacías, el captcha se desactiva (el formulario sigue funcionando
# con el honeypot). Pon las DOS para activarlo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://praxedesdevilallonga.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.praxedesdevilallonga.com"

# ── Analítica ─────────────────────────────────────────────────
# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si se deja vacío, GA no se carga (útil en desarrollo).
NEXT_PUBLIC_GA_ID=""

# ── Seed (solo para setup inicial) ───────────────────────────
ADMIN_EMAIL="admin@praxedesdevilallonga.com"
ADMIN_PASSWORD="cambiar-esto"
