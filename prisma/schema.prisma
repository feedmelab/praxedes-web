// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon requiere esta para migraciones
}

// ── Auth ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Projects ──────────────────────────────────────────────────

enum ProjectCategory {
  COMMERCIALS
  FILM_TV
  EDITORIAL
}

model Project {
  id         String          @id @default(cuid())
  slug       String          @unique
  category   ProjectCategory
  client     String
  year       Int
  titleEs    String
  titleEn    String
  descEs     String?         @db.Text
  descEn     String?         @db.Text
  vimeoId    String?
  coverImage String?         // ImageKit URL
  published  Boolean         @default(false)
  featured   Boolean         @default(false)
  coverFocal ImageFocal      @default(TOP) // encuadre de la portada en las tarjetas
  coverLetterbox Boolean     @default(false) // recortar franjas negras (fotograma) en el listado
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  images ProjectImage[]
  frames VideoFrame[]

  @@index([category, published])
  @@index([featured, published])
}

// ── Project media (galería: imagen o vídeo) ───────────────────

enum MediaKind {
  IMAGE
  VIDEO
}

// Punto de anclaje del recorte (object-position) al mostrar una imagen recortada.
enum ImageFocal {
  TOP
  CENTER
  BOTTOM
}

model ProjectImage {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      MediaKind @default(IMAGE)

  // Solo para kind = IMAGE (foto subida o fotograma extraído de un vídeo):
  fileId String? // ImageKit fileId para borrado
  url    String? // ImageKit URL base (sin transformaciones)
  width  Int?
  height Int?

  // Solo para kind = VIDEO (un vídeo Vimeo como item de la galería):
  // guarda "id" o "id?h=hash" (se parsea con parseVimeo).
  vimeoId String?

  wide      Boolean    @default(false) // true = ocupa 2 columnas en la galería
  focal     ImageFocal @default(TOP) // encuadre del recorte en la galería
  altEs     String?
  altEn     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, order])
}

// ── Video frames ──────────────────────────────────────────────

model VideoFrame {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId    String   // ImageKit fileId
  url       String   // ImageKit URL base
  width     Int
  height    Int
  timecode  Float    // segundos en el vídeo fuente
  labelEs   String?
  labelEn   String?
  order     Int      @default(0)
  published Boolean  @default(false) // false = solo documentación interna
  createdAt DateTime @default(now())

  @@index([projectId, order])
}

// ── Rental ────────────────────────────────────────────────────

enum RentalCategory {
  PERIOD
  CONTEMPORARY
  ACCESSORIES
  PROPS
  OTHER
}

model RentalItem {
  id        String         @id @default(cuid())
  nameEs    String
  nameEn    String
  descEs    String?        @db.Text
  descEn    String?        @db.Text
  category  RentalCategory
  images    Json           @default("[]") // array de { fileId, url, width, height }
  available Boolean        @default(true) // visible/alquilable en la web
  stock     Int            @default(1)    // unidades disponibles de la pieza
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  reservations Reservation[]
}

// ── Reservas de alquiler (módulo E) ───────────────────────────

enum ReservationStatus {
  PENDING // solicitud del cliente pendiente de confirmar por el admin
  CONFIRMED
  CANCELLED
}

enum ReservationKind {
  CUSTOMER // reserva de un cliente
  BLOCK    // bloqueo interno (mantenimiento / uso propio)
}

model Reservation {
  id        String            @id @default(cuid())
  itemId    String
  item      RentalItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  startDate DateTime          @db.Date // inclusivo
  endDate   DateTime          @db.Date // exclusivo (día de devolución)
  quantity  Int               @default(1)
  status    ReservationStatus @default(CONFIRMED)
  kind      ReservationKind   @default(CUSTOMER)

  customerName  String?
  customerEmail String?
  customerPhone String?
  notes         String?  @db.Text
  locale        String   @default("es") // idioma del cliente para los emails

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId, startDate, endDate])
  @@index([status])
}

// ── Site settings (singleton) ─────────────────────────────────

// Plantillas de email editables desde el panel. key ∈ {rental_request,
// rental_confirmed}. El cuerpo admite variables {name} {item} {quantity}
// {period} {start} {end}.
model EmailTemplate {
  key       String   @id
  subjectEs String   @db.Text
  bodyEs    String   @db.Text
  subjectEn String   @db.Text
  bodyEn    String   @db.Text
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id           String   @id @default("singleton")
  reelVimeoId  String?
  reelMp4Url   String? // vídeo de fondo alternativo (MP4 directo)
  claimEs      String?
  claimEn      String?
  aboutTitleEs String?
  aboutTitleEn String?
  homeIntroEs  String?  @db.Text
  homeIntroEn  String?  @db.Text
  bioEs        String?  @db.Text
  bioEn        String?  @db.Text
  aboutImage   String? // foto de «Sobre mí» (URL de ImageKit)
  micInfoEs    String?  @db.Text
  micInfoEn    String?  @db.Text
  clientsList  String?  @db.Text // lista curada (uno por línea); si vacío, se derivan de los proyectos
  effectBase   String? // color base del efecto WebGL del nombre (hex)
  effectAccent String? // color de acento (con el sonido) del efecto WebGL (hex)
  heroDarken     Int @default(35) // oscurecido general del vídeo del hero (0–100)
  heroFadeBottom Int @default(70) // fundido inferior al color de la página (0–100)
  heroScrollFade Int @default(85) // fundido global al hacer scroll (0–100)
  waterOpacity   Int @default(100) // intensidad del fondo de agua parallax (0–250 %)
  waterDarken    Int @default(0) // velo oscuro sobre el fondo de agua (0–100)
  contactEmail String?
  instagramUrl String?
  vimeoUrl     String?
  updatedAt    DateTime @updatedAt
}
